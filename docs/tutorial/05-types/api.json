{
  "openapi": "3.1.0",
  "info": { "title": "Projects, types only", "version": "1" },
  "components": {
    "schemas": {
      "Project": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "color": { "type": "string", "maxLength": 7 }
        }
      },
      "ProjectCreate": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "color": { "type": "string", "maxLength": 7 }
        }
      }
    }
  }
}
