// Writes the generated source from load's tables: for each enum, the enum,
// its reader and its writer; for each object, the struct, its reader, a
// reader per array field, and its writer. docs/generator.md shows the code.
namespace gen;

import std;
import json;

// The type's spelling in a struct field.
fn format_type(out: u8[>..]&, ty: Ty, objs, enums) {
    if ty.kind == K_BOOL { out.append("bool"); }
    else if ty.kind == K_INT { out.append("i64"); }
    else if ty.kind == K_NUM { out.append("f64"); }
    else if ty.kind == K_STR {
        if ty.max_len >= 0 { format(out, "u8[..", ty.max_len * 4, "]"); } else { out.append("u8[]"); }
    }
    else if ty.kind == K_ENUM { out.append(enums[ty.ref].name); }
    else if ty.kind == K_OBJ { out.append(objs[ty.ref].name); }
}

fn format_field_type(out: u8[>..]&, f: Field, objs, enums) {
    if f.ty.kind == K_ARR {
        format_type(out, f.item, objs, enums);
        out.append("[]");
    } else {
        format_type(out, f.ty, objs, enums);
    }
}

// A bound as the schema writes it: an integer, or the shortest form of
// the number that reads back as it.
fn format_bound(out: u8[>..]&, n: json::Node&) {
    match n.val {
        Int i => format(out, i.v),
        Num x => json::format_number(out, x.v),
        _ => {},
    }
}

fn format_snake_name(out: u8[>..]&, name: const u8[:]) {
    let ok = format_snake(out, name);
}

// The checks on a value read into the local named x, as statements at
// indent that fail the reader with "<what>: <keyword>". present is the
// condition under which the value was read, or "" for always.
fn format_checks(out: u8[>..]&, ty: Ty, x: const u8[:], what: const u8[:], present: const u8[:], indent: const u8[:]) {
    let when = if present.len > 0 { str(present, " && ") } else { str("") };
    if ty.kind == K_STR {
        if ty.min_len >= 0 || ty.max_len >= 0 {
            if present.len > 0 { format(out, indent, "if ", present, " {\n"); } else { format(out, indent, "{\n"); }
            format(out, indent, "    let n_ = rest::code_points(", x, ");\n");
            format(out, indent, "    if n_ < 0 { json::fail(r, \"", what, ": not UTF-8\"); }\n");
            if ty.min_len > 0 {
                format(out, indent, "    if n_ >= 0 && n_ < ", ty.min_len, " { json::fail(r, \"", what, ": minLength\"); }\n");
            }
            if ty.max_len >= 0 {
                format(out, indent, "    if n_ > ", ty.max_len, " { json::fail(r, \"", what, ": maxLength\"); }\n");
            }
            format(out, indent, "}\n");
        }
        if ty.format > 0 {
            let f = if ty.format == F_DATE { "is_date" } else if ty.format == F_DATE_TIME { "is_date_time" }
                else if ty.format == F_UUID { "is_uuid" } else { "is_email" };
            format(out, indent, "if ", when, "!rest::", f, "(", x, ") { json::fail(r, \"", what, ": format\"); }\n");
        }
    } else if ty.kind == K_INT || ty.kind == K_NUM {
        if ty.int32 {
            format(out, indent, "if ", when, "(", x, " < -2147483648 || ", x, " > 2147483647) { json::fail(r, \"", what, ": format\"); }\n");
        }
        bound_check(out, ty.minimum, x, " < ", "minimum", what, when, indent);
        bound_check(out, ty.exclusive_minimum, x, " <= ", "exclusiveMinimum", what, when, indent);
        bound_check(out, ty.maximum, x, " > ", "maximum", what, when, indent);
        bound_check(out, ty.exclusive_maximum, x, " >= ", "exclusiveMaximum", what, when, indent);
    }
}

fn bound_check(out: u8[>..]&, b: json::Node?, x: const u8[:], op: const u8[:], keyword: const u8[:],
               what: const u8[:], when: const u8[:], indent: const u8[:]) {
    guard b else { return; }
    format(out, indent, "if ", when, x, op);
    format_bound(out, b);
    format(out, " { json::fail(r, \"", what, ": ", keyword, "\"); }\n");
}

// Whether a value of ty needs rest's checks.
fn uses_rest(ty: Ty) -> bool {
    ty.kind == K_STR &&(ty.min_len >= 0 || ty.max_len >= 0 || ty.format > 0)
}

// Writes the file's head, types, readers, and writers. handlers names the
// namespace of a router's handlers, or is "" for a file without one. The
// file doesn't import the handlers' module: the program's root does, from
// wherever it lives, and a qualified call finds it.
fn emit(out: u8[>..]&, ns: const u8[:], handlers: const u8[:], source: const u8[:], objs, enums, fields, variants) {
    var needs_rest = handlers.len > 0 || objs.len > 0;
    for f in fields { if uses_rest(f.ty) || uses_rest(f.item) { needs_rest = true; } }
    format(out, "// Generated by goose-rest gen from ", source, ". Don't edit: change the schema and\n");
    out.append("// regenerate.\n");
    format(out, "namespace ", ns, ";\n\nimport std;\nimport json;\n");
    if handlers.len > 0 { out.append("import http;\n"); }
    if needs_rest { out.append("import rest;\n"); }
    for e in enums { emit_enum(out, e, variants); }
    for o in objs { emit_obj(out, ns, o, objs, enums, fields, variants); }
}

fn emit_enum(out: u8[>..]&, e: Enum, variants) {
    format(out, "\n// ", e.ptr, "\nenum ", e.name, " {");
    for k in e.first..e.first + e.count {
        if k > e.first { out.push(','); }
        format(out, " ", variants[k]);
    }
    out.append(" }\n");

    // The reader: by length, then bytes.
    format(out, "\n// The variant whose value is s, and whether there is one.\nfn ");
    format_snake_name(out, e.name);
    format(out, "_of(s: const u8[:]) -> ", e.name, ", bool {\n    match s.len {\n");
    var lens: i64[>..] = [];
    json::each(e.values) { v =>
        let s, ok = json::as_string(v);
        if !is_one_of_len(lens, s.len) { lens.push(s.len); }
    };
    sort(lens) { a, b => a < b };
    for n in lens {
        format(out, "        ", n, " => ");
        var k = e.first;
        var first = true;
        json::each(e.values) { v =>
            let s, ok = json::as_string(v);
            if s.len == n {
                if !first { out.append(" else "); }
                format(out, "if s == \"", s, "\" { return ", e.name, ".", variants[k], ", true; }");
                first = false;
            }
            k++;
        };
        out.append(",\n");
    }
    format(out, "        _ => {},\n    }\n    return ", e.name, ".", variants[e.first], ", false;\n}\n");

    // The writer: each value's bytes a constant.
    format(out, "\nfn format(out: u8[>..]&, v: ", e.name, ") {\n    match v {\n");
    var k = e.first;
    json::each(e.values) { v =>
        let s, ok = json::as_string(v);
        format(out, "        ", variants[k], " => out.append(\"\\\"", s, "\\\"\"),\n");
        k++;
    };
    out.append("    }\n}\n");
}

fn is_one_of_len(lens: const i64[:], n: i64) -> bool {
    for x in lens { if x == n { return true; } }
    return false;
}

// The expression that reads a scalar of ty from r, or "" for one that
// takes statements of its own (an enum).
fn read_call(ty: Ty) -> const u8[:] {
    if ty.kind == K_BOOL { return "json::read_bool(r)"; }
    if ty.kind == K_INT { return "json::read_int(r)"; }
    if ty.kind == K_NUM { return "json::read_number(r)"; }
    if ty.kind == K_STR { return "json::read_string(r, scratch)"; }
    return "";
}

fn emit_obj(out: u8[>..]&, ns: const u8[:], o: Obj, objs, enums, fields, variants) {
    let fs = fields[o.first..o.first + o.count];
    var reader: u8[>..] = [];
    format_snake_name(reader, o.name);

    // The struct.
    format(out, "\n// ", o.ptr, "\nstruct ", o.name, " {");
    if fs.len == 0 { out.append(" }\n"); }
    else {
        out.push('\n');
        for f in fs {
            if !f.required { format(out, "    has_", f.name, ": bool,\n"); }
            if f.ty.nullable { format(out, "    ", f.name, "_null: bool,\n"); }
            format(out, "    ", f.name, ": ");
            format_field_type(out, f, objs, enums);
            out.append(",\n");
        }
        out.append("}\n");
    }

    // The reader, first pass: scalars and strings as their keys arrive,
    // nested values by where they start.
    format(out, "\n// Reads the ", o.name, " at the cursor, checks it, and builds it once. Errors\n");
    out.append("// are sticky, as json::Reader's are: after one, it returns an empty value.\n");
    format(out, "fn read_", reader, "(r: json::Reader&, scratch: u8[>..]&) -> ", o.name, " {\n");
    var nested = false;
    for f in fs {
        let k = f.ty.kind;
        if k == K_OBJ || k == K_ARR {
            format(out, "    var ", f.name, "_at = -1;\n");
            nested = true;
        } else {
            format(out, "    var ", f.name, " = ");
            if k == K_BOOL { out.append("false"); }
            else if k == K_INT { out.append("0"); }
            else if k == K_NUM { out.append("0.0"); }
            else if k == K_STR { out.append("r.text[..0]"); }
            else if k == K_ENUM { format(out, enums[f.ty.ref].name, ".", variants[enums[f.ty.ref].first]); }
            out.append(";\n");
        }
        format(out, "    var has_", f.name, " = false;\n");
        if f.ty.nullable { format(out, "    var ", f.name, "_null = false;\n"); }
    }
    let unknown = if o.closed { "json::fail(r, \"unknown member\")" } else { "json::skip(r)" };
    out.append("    json::each_member(r) { key =>\n        match key.len {\n");
    var lens: i64[>..] = [];
    for f in fs { if !is_one_of_len(lens, f.key.len) { lens.push(f.key.len); } }
    sort(lens) { a, b => a < b };
    for n in lens {
        format(out, "            ", n, " => ");
        var first = true;
        for f in fs {
            if f.key.len != n { continue; }
            if !first { out.append(" else "); }
            first = false;
            format(out, "if key == \"", f.key, "\" {\n");
            var body = "                ";
            if f.ty.nullable {
                format(out, body, "if json::peek(r) == 'n' {\n");
                format(out, body, "    json::skip(r);\n");
                format(out, body, "    ", f.name, "_null = true;\n");
                if f.ty.kind == K_OBJ || f.ty.kind == K_ARR { format(out, body, "    ", f.name, "_at = -1;\n"); }
                format(out, body, "} else {\n");
                format(out, body, "    ", f.name, "_null = false;\n");
                read_value(out, f, enums, "                    ");
                format(out, body, "}\n");
            } else {
                read_value(out, f, enums, body);
            }
            format(out, body, "has_", f.name, " = true;\n");
            out.append("            }");
        }
        format(out, " else {\n                ", unknown, ";\n            },\n");
    }
    format(out, "            _ => ", unknown, ",\n        }\n    };\n");

    // The checks.
    for f in fs {
        if f.required { format(out, "    if !has_", f.name, " { json::fail(r, \"", f.key, ": required\"); }\n"); }
        var present: u8[>..] = [];
        if !f.required { format(present, "has_", f.name); }
        if f.ty.nullable {
            if present.len > 0 { present.append(" && "); }
            format(present, "!", f.name, "_null");
        }
        format_checks(out, f.ty, f.name, f.key, present, "    ");
    }

    // The second pass: the value, built once at its destination, with each
    // nested value read where it starts.
    format(out, "    if r.error.len > 0 { return ", o.name, " { .. }; }\n");
    if nested { format(out, "    let end_ = r.pos;\n    let v_ = ", o.name, " {"); }
    else { format(out, "    return ", o.name, " {"); }
    if fs.len == 0 { out.append(" "); }
    else { out.push('\n'); }
    for f in fs {
        if !f.required { format(out, "        has_", f.name, ": has_", f.name, ",\n"); }
        if f.ty.nullable { format(out, "        ", f.name, "_null: ", f.name, "_null,\n"); }
        format(out, "        ", f.name, ": ");
        if f.ty.kind == K_OBJ {
            format(out, "if ", f.name, "_at >= 0 { r.pos = ", f.name, "_at; read_");
            format_snake_name(out, objs[f.ty.ref].name);
            format(out, "(r, scratch) } else { ", objs[f.ty.ref].name, " { .. } },\n");
        } else if f.ty.kind == K_ARR {
            format(out, "if ", f.name, "_at >= 0 { r.pos = ", f.name, "_at; read_", reader, "_", f.name, "(r, scratch) } else { [] },\n");
        } else {
            format(out, f.name, ",\n");
        }
    }
    if fs.len > 0 { out.append("    "); }
    out.append("};\n");
    if nested { out.append("    r.pos = end_;\n    return v_;\n"); }
    out.append("}\n");

    // A reader per array field.
    for f in fs {
        if f.ty.kind != K_ARR { continue; }
        let it = f.item;
        format(out, "\n// The elements of ", o.name, ".", f.name, ".\n");
        format(out, "fn read_", reader, "_", f.name, "(r: json::Reader&, scratch: u8[>..]&) -> ");
        format_type(out, it, objs, enums);
        out.append("[>..] {\n    var v_: ");
        format_type(out, it, objs, enums);
        out.append("[>..] = [];\n    json::each_element(r) {\n");
        let what = str(f.key, "[]");
        if it.kind == K_OBJ {
            format(out, "        push_");
            format_snake_name(out, objs[it.ref].name);
            out.append("(v_, r, scratch);\n");
        } else if it.kind == K_ENUM {
            out.append("        let s_ = json::read_string(r, scratch);\n        let e_, ok_ = ");
            format_snake_name(out, enums[it.ref].name);
            format(out, "_of(s_);\n        if !ok_ { json::fail(r, \"", what, ": enum\"); }\n        v_.push(e_);\n");
        } else {
            format(out, "        let x_ = ", read_call(it), ";\n");
            format_checks(out, it, "x_", what, "", "        ");
            if it.kind == K_STR && it.max_len >= 0 {
                out.append("        if r.error.len == 0 { v_.push(x_); }\n");
            } else {
                out.append("        v_.push(x_);\n");
            }
        }
        out.append("    };\n");
        if f.ty.min_items > 0 { format(out, "    if v_.len < ", f.ty.min_items, " { json::fail(r, \"", f.key, ": minItems\"); }\n"); }
        if f.ty.max_items >= 0 { format(out, "    if v_.len > ", f.ty.max_items, " { json::fail(r, \"", f.key, ": maxItems\"); }\n"); }
        out.append("    return v_;\n}\n");
    }

    if o.pushed {
        format(out, "\n// Pushes a ", o.name, " read from r onto v. An array reader's block calls this\n");
        out.append("// rather than pushing itself (goose-rest's docs/goose-findings.md).\n");
        format(out, "fn push_", reader, "(v: ", o.name, "[>..]&, r: json::Reader&, scratch: u8[>..]&) {\n");
        format(out, "    v.push(read_", reader, "(r, scratch));\n}\n");
    }

    emit_writer(out, o, fs);

    // The extractor. Names in its body resolve in rest, so its own are
    // qualified.
    format(out, "\n// The ", o.name, " a request's JSON body holds, for rest::take: 415 for another\n");
    format(out, "// media type, and 400 invalid_body for a body read_", reader, " refuses.\n");
    format(out, "fn rest::from_request(cx, v: const ", ns, "::", o.name, "?) -> ", ns, "::", o.name, " {\n");
    format(out, "    rest::json_body(cx) { r, scratch => ", ns, "::read_", reader, "(r, scratch) }\n}\n");
}

// The statements that read field f's value at the cursor into its local.
fn read_value(out: u8[>..]&, f: Field, enums, indent: const u8[:]) {
    let k = f.ty.kind;
    if k == K_OBJ || k == K_ARR {
        format(out, indent, f.name, "_at = r.pos;\n");
        format(out, indent, "json::skip(r);\n");
    } else if k == K_ENUM {
        format(out, indent, "let s_ = json::read_string(r, scratch);\n");
        format(out, indent, "let e_, ok_ = ");
        format_snake_name(out, enums[f.ty.ref].name);
        format(out, "_of(s_);\n", indent, f.name, " = e_;\n");
        format(out, indent, "if !ok_ { json::fail(r, \"", f.key, ": enum\"); }\n");
    } else {
        format(out, indent, f.name, " = ", read_call(f.ty), ";\n");
    }
}

// The statement that writes the value x of ty, which isn't an array.
fn write_one(out: u8[>..]&, ty: Ty, x: const u8[:], indent: const u8[:]) {
    let k = ty.kind;
    if k == K_BOOL { format(out, indent, "json::format_bool(out, ", x, ");\n"); }
    else if k == K_INT { format(out, indent, "json::format_int(out, ", x, ");\n"); }
    else if k == K_NUM { format(out, indent, "json::format_number(out, ", x, ");\n"); }
    else if k == K_STR { format(out, indent, "json::format_string(out, ", x, ");\n"); }
    else if k == K_ENUM || k == K_OBJ { format(out, indent, "format(out, ", x, ");\n"); }
}

// The statements that write the value x of ty, an array of item or not.
fn write_value(out: u8[>..]&, ty: Ty, item: Ty, x: const u8[:], indent: const u8[:]) {
    guard ty.kind == K_ARR else { write_one(out, ty, x, indent); return; }
    format(out, indent, "out.push('[');\n");
    format(out, indent, "for e_, i_ in ", x, " {\n");
    format(out, indent, "    if i_ > 0 { out.push(','); }\n");
    write_one(out, item, "e_", str(indent, "    "));
    format(out, indent, "}\n");
    format(out, indent, "out.push(']');\n");
}

// The writer: only the declared fields, each key's bytes a constant. A key
// after a field that may be absent checks the last byte for the '{' to
// know whether it needs a comma.
fn emit_writer(out: u8[>..]&, o: Obj, fs) {
    format(out, "\n// Writes only the declared fields, each key's bytes a constant.\n");
    format(out, "fn format(out: u8[>..]&, v: const ", o.name, "&) {\n");
    if fs.len == 0 { out.append("    out.append(\"{}\");\n}\n"); return; }
    // 0: nothing written yet, 1: a field written, 2: either.
    var state = 0;
    var open = false;
    if !fs[0].required { out.append("    out.push('{');\n"); open = true; }
    for f in fs {
        var indent = "    ";
        if !f.required {
            format(out, "    if v.has_", f.name, " {\n");
            indent = "        ";
        }
        if state == 2 { format(out, indent, "if out[out.len - 1] != '{' { out.push(','); }\n"); }
        format(out, indent, "out.append(\"");
        if !open { out.push('{'); open = true; }
        if state == 1 { out.push(','); }
        format(out, "\\\"", f.key, "\\\":\");\n");
        let x = str("v.", f.name);
        if f.ty.nullable {
            format(out, indent, "if v.", f.name, "_null {\n");
            format(out, indent, "    out.append(\"null\");\n");
            format(out, indent, "} else {\n");
            write_value(out, f.ty, f.item, x, str(indent, "    "));
            format(out, indent, "}\n");
        } else {
            write_value(out, f.ty, f.item, x, indent);
        }
        if !f.required { out.append("    }\n"); }
        state = if f.required { 1 } else if state == 1 { 1 } else { 2 };
    }
    out.append("    out.push('}');\n}\n");
}
